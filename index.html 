```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KRA iTax Mobile - Citizen Portal</title>
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .glass-effect { background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(10px); }
        .stk-push-anim { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
    </style>
</head>
<body class="bg-slate-50 text-slate-900">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        // --- MOCK DATABASE (Simulating a Backend DB) ---
        const MOCK_DB = {
            citizens: [
                { id: "12345678", phone: "0712345678", name: "SAMUEL OKOTH OMONDI", pin: "A014567890Z", status: "Employed", employer: "Global Tech Solutions Ltd", taxDue: 12450 },
                { id: "87654321", phone: "0788112233", name: "JANE WAMBUI KAMAU", pin: "A099887766X", status: "Self-Employed", employer: "Creative Studio", taxDue: 5200 }
            ]
        };

        const App = () => {
            const [view, setView] = useState('login'); // login, dashboard, stk, success
            const [user, setUser] = useState(null);
            const [idInput, setIdInput] = useState('');
            const [phoneInput, setPhoneInput] = useState('');
            const [isLoading, setIsLoading] = useState(false);
            const [errorMessage, setErrorMessage] = useState('');

            // --- BACKEND API SIMULATION ---
            const apiRequest = (type, payload) => {
                return new Promise((resolve, reject) => {
                    setTimeout(() => {
                        if (type === 'LOGIN') {
                            const found = MOCK_DB.citizens.find(c => c.id === payload.id && c.phone === payload.phone);
                            found ? resolve(found) : reject("Credentials not found in KRA Registry.");
                        }
                        if (type === 'PAYMENT') {
                            resolve({ status: "SUCCESS", receipt: "QH" + Math.random().toString(36).toUpperCase().substring(2, 10) });
                        }
                    }, 1500);
                });
            };

            const handleLogin = async (e) => {
                e.preventDefault();
                setIsLoading(true);
                setErrorMessage('');
                try {
                    const data = await apiRequest('LOGIN', { id: idInput, phone: phoneInput });
                    setUser(data);
                    setView('dashboard');
                } catch (err) {
                    setErrorMessage(err);
                } finally {
                    setIsLoading(false);
                }
            };

            const handlePayment = async () => {
                setView('stk');
                await apiRequest('PAYMENT');
                setView('success');
            };

            // --- UI COMPONENTS ---

            const Login = () => (
                <div className="min-h-screen flex items-center justify-center p-4">
                    <div className="w-full max-w-md bg-white rounded-[2rem] shadow-2xl border border-slate-100 overflow-hidden">
                        <div className="bg-emerald-600 p-10 text-white text-center">
                            <i className="fa-solid fa-shield-halved text-5xl mb-4"></i>
                            <h1 className="text-2xl font-extrabold uppercase tracking-tight">KRA iTax Portal</h1>
                            <p className="text-emerald-100 text-sm opacity-80">Government of Kenya</p>
                        </div>
                        <form onSubmit={handleLogin} className="p-8 space-y-5">
                            <div>
                                <label className="block text-xs font-bold text-slate-400 uppercase mb-2">ID Number</label>
                                <div className="relative">
                                    <i className="fa-solid fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                                    <input value={idInput} onChange={e => setIdInput(e.target.value)} required type="text" placeholder="12345678" className="w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 outline-none" />
                                </div>
                            </div>
                            <div>
                                <label className="block text-xs font-bold text-slate-400 uppercase mb-2">M-Pesa Number</label>
                                <div className="relative">
                                    <i className="fa-solid fa-phone absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                                    <input value={phoneInput} onChange={e => setPhoneInput(e.target.value)} required type="text" placeholder="0712345678" className="w-full pl-12 pr-4 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 outline-none" />
                                </div>
                            </div>
                            {errorMessage && <p className="text-red-500 text-sm text-center font-medium"><i className="fa-solid fa-circle-exclamation mr-1"></i> {errorMessage}</p>}
                            <button className="w-full bg-emerald-600 text-white font-bold py-4 rounded-2xl hover:bg-emerald-700 transition shadow-lg shadow-emerald-200 flex items-center justify-center gap-2">
                                {isLoading ? <i className="fa-solid fa-spinner animate-spin"></i> : "Login to iTax"}
                            </button>
                            <div className="text-center pt-2">
                                <p className="text-xs text-slate-400">Competition Demo: Use ID 12345678 & Phone 0712345678</p>
                            </div>
                        </form>
                    </div>
                </div>
            );

            const Dashboard = () => (
                <div className="min-h-screen pb-10">
                    <div className="bg-white border-b px-6 py-4 flex justify-between items-center sticky top-0 z-50">
                        <div className="flex items-center gap-2">
                            <div className="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center text-white font-bold">K</div>
                            <span className="font-bold text-slate-800">iTax Smart</span>
                        </div>
                        <button onClick={() => setView('login')} className="text-slate-400 font-bold text-sm">LOGOUT</button>
                    </div>
                    
                    <div className="max-w-xl mx-auto p-6 space-y-6">
                        <div className="bg-white p-8 rounded-[2rem] shadow-sm border border-slate-100">
                            <div className="flex justify-between mb-4">
                                <h2 className="text-xl font-bold">{user.name}</h2>
                                <span className="bg-emerald-100 text-emerald-700 text-[10px] px-2 py-1 rounded-md font-black">PIN: {user.pin}</span>
                            </div>
                            <div className="grid grid-cols-2 gap-4">
                                <div className="bg-slate-50 p-4 rounded-2xl">
                                    <p className="text-[10px] text-slate-400 font-bold uppercase">Status</p>
                                    <p className="font-bold">{user.status}</p>
                                </div>
                                <div className="bg-slate-50 p-4 rounded-2xl">
                                    <p className="text-[10px] text-slate-400 font-bold uppercase">Employer</p>
                                    <p className="font-bold truncate">{user.employer}</p>
                                </div>
                            </div>
                        </div>

                        <div className="bg-slate-900 rounded-[2.5rem] p-10 text-white relative overflow-hidden shadow-2xl">
                            <p className="text-slate-400 font-medium mb-1">Total Outstanding Returns</p>
                            <h3 className="text-4xl font-black mb-8">KES {user.taxDue.toLocaleString()}</h3>
                            <button onClick={handlePayment} className="w-full bg-emerald-500 py-5 rounded-2xl font-black text-lg hover:bg-emerald-400 transition flex items-center justify-center gap-3">
                                <i className="fa-solid fa-mobile-screen-button"></i>
                                PAY VIA M-PESA
                            </button>
                            <div className="absolute -bottom-10 -right-10 w-40 h-40 bg-white/5 rounded-full"></div>
                        </div>

                        <div className="grid grid-cols-2 gap-4">
                            <div className="bg-white p-6 rounded-3xl border border-slate-100 text-center">
                                <i className="fa-solid fa-clock-rotate-left text-emerald-500 text-xl mb-2"></i>
                                <p className="text-xs font-bold">History</p>
                            </div>
                            <div className="bg-white p-6 rounded-3xl border border-slate-100 text-center">
                                <i className="fa-solid fa-file-invoice text-emerald-500 text-xl mb-2"></i>
                                <p className="text-xs font-bold">Certificates</p>
                            </div>
                        </div>
                    </div>
                </div>
            );

            const STKPush = () => (
                <div className="min-h-screen bg-emerald-600 flex flex-col items-center justify-center p-10 text-white text-center">
                    <div className="w-24 h-24 bg-white/20 rounded-full flex items-center justify-center mb-8 stk-push-anim">
                        <i className="fa-solid fa-fingerprint text-4xl"></i>
                    </div>
                    <h2 className="text-3xl font-black mb-4">Check your phone</h2>
                    <p className="text-emerald-100 opacity-90 max-w-xs leading-relaxed">
                        We have sent an STK Push to <span className="font-black underline">{phoneInput}</span>. 
                        Please enter your M-Pesa PIN to authorize the payment.
                    </p>
                </div>
            );

            const Success = () => (
                <div className="min-h-screen bg-slate-50 flex items-center justify-center p-6">
                    <div className="w-full max-w-md bg-white rounded-[2.5rem] shadow-2xl overflow-hidden text-center">
                        <div className="bg-emerald-500 p-12 text-white">
                            <i className="fa-solid fa-circle-check text-7xl mb-4"></i>
                            <h2 className="text-3xl font-black">Payment Confirmed!</h2>
                            <p className="opacity-80">Government Ledger Updated</p>
                        </div>
                        <div className="p-8 space-y-6">
                            <div className="bg-slate-50 p-6 rounded-3xl border-4 border-dashed border-slate-200 inline-block">
                                <i className="fa-solid fa-qrcode text-[120px] text-slate-800"></i>
                            </div>
                            <div className="space-y-2">
                                <div className="flex justify-between text-sm font-bold"><span className="text-slate-400">Receipt:</span> <span>QH928KJS1</span></div>
                                <div className="flex justify-between text-sm font-bold"><span className="text-slate-400">Filing ID:</span> <span>KRA-2024-X09</span></div>
                            </div>
                            <button onClick={() => setView('dashboard')} className="w-full bg-slate-900 text-white py-4 rounded-2xl font-bold">Back to Dashboard</button>
                        </div>
                    </div>
                </div>
            );

            if (view === 'login') return <Login />;
            if (view === 'dashboard') return <Dashboard />;
            if (view === 'stk') return <STKPush />;
            if (view === 'success') return <Success />;
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>

```
